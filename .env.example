# Copy manually to untracked .env. No runtime loads .env automatically in M0/M1.
DATABASE_PATH=D:/CampusOps/var/data/campusops.db
APP_TZ=Asia/Shanghai
# Agent Core implements explicit opt-in; never activate a paid fallback.
CAMPUSOPS_LLM_ENABLED=false
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_ID=
MODEL_CALLS_PER_RUN_MAX=6
MODEL_DAILY_CALLS_MAX=30
REPLAN_MAX=2
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=1600
# Manual provider option only; default omits the field. Ark short JSON roles: disabled.
MODEL_THINKING=default
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
